# Local LLM used for explanations. Anything Ollama can serve works.
#
# qwen3.5:4b (3.4GB) is the default: it follows the "explain, never re-classify"
# constraint well and runs at a usable speed on CPU. Note that qwen3:4b is NOT a
# drop-in substitute -- that build emits its reasoning trace as visible content
# regardless of think:false or /no_think, which lands "Okay, the user wants me
# to..." in the explanation panel.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
