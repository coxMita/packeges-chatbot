bl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#86868B;fontFamily=Helvetica;fontSize=12;fontColor=#1D1D1F;" vertex="1" parent="1"><mxGeometry x="980" y="310" width="220" height="80" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6E6E73;fontColor=#3A3A3C;fontSize=11;fontFamily=Helvetica;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="275"/><mxPoint x="940" y="350"/></Array></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;future (outside)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6E6E73'&gt;1,225 malware reported ≥ 2025-06-01,&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6E6E73'&gt;family never seen before&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#86868B;fontFamily=Helvetica;fontSize=12;fontColor=#1D1D1F;" vertex="1" parent="1"><mxGeometry x="980" y="420" width="220" height="80" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6E6E73;fontColor=#3A3A3C;fontSize=11;fontFamily=Helvetica;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c14" target="c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="275"/><mxPoint x="940" y="460"/></Array></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;train_gbdt.py (Model A)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6E6E73'&gt;LightGBM, grouped 5-fold CV&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6E6E73'&gt;thresholds: F0.5 · review 1% · strict 0.1%&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6E6E73'&gt;saves feature_reference.npz&lt;/font&gt