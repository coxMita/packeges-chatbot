nd (service_healthy)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6E6E73'&gt;backend → ollama (service_started):&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6E6E73'&gt;verdicts work while the model is still downloading&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBEA;strokeColor=#C7C7CC;align=left;spacingLeft=8;fontFamily=Helvetica;fontSize=11;fontColor=#1D1D1F;" vertex="1" parent="1"><mxGeometry x="880" y="780" width="460" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
