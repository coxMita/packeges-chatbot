<mxfile host="app.diagrams.net" type="device"><diagram id="Deployment" name="Deployment"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Package Inspector — deployment (Docker Compose)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontFamily=Helvetica;fontColor=#1D1D1F;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="36" as="geometry"/></mxCell><mxCell id="c3" value="docker compose up -d --build → http://localhost:8080. Only the UI port is published, bound to 127.0.0.1. All containers: non-root, cap_drop ALL, no-new-privileges, restart unless-stopped, CPU/memory limits." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#6E6E73;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1300" height="36" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Web browser&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#6E6E73'&gt;developer workstation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#86868B;dashed=1;fontFamily=Helvetica;fontSize=12;fontColor=#1D1D1F;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="170" height="60" as="geometry"/></mxCell><mxCell id="c5" value="Docker host (Linux laptop, 12 cores / 14 GB) — compose project 'packeges-chatbot'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F5F5F7;strokeColor=#C7C7CC;dashed=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontFamily=Helvetica;fontSize=12;fontColor=#1D1D1F;" vertex="1" parent="1"><mxGeometry x="260" y="110" width="1110" height="640" as="geometry"/></mxCell><mxCell id="c6" value="network: web (bridge)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F5F5F7;strokeC