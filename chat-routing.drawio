<mxfile host="app.diagrams.net" type="device"><diagram id="Chat message routing" name="Chat message routing"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Activity — how a chat message is routed" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontFamily=Helvetica;fontColor=#1D1D1F;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="36" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;html=1;fillColor=#1D1D1F;strokeColor=#1D1D1F;" vertex="1" parent="1"><mxGeometry x="390" y="80" width="30" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;User sends a message&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#86868B;fontFamily=Helvetica;fontSize=12;fontColor=#1D1D1F;" vertex="1" parent="1"><mxGeometry x="320" y="140" width="170" height="50" as="geometry"/></mxCell><mxCell id="c5" value="Matches a package pattern?&lt;br&gt;&lt;font style='font-size:10px' color='#6E6E73'&gt;name[==ver] · check X · pip install X ·&lt;br&gt;is X safe? · what about X?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D1D1F;fontFamily=Helvetica;fontSize=12;fontColor=#1D1D1F;" vertex="1" parent="1"><mxGeometry x="285" y="220" width="240" height="130" as="geometry"/></mxCell><mxCell id="c6" value="Name is a chat word?&lt;br&gt;&lt;font style='font-size:10px' color='#6E6E73'&gt;it, this, why, help, …&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D1D1F;fontFamily=Helvetica;fontSize=12;fontColor=#1D1D1F;" vertex="1" parent="1"><mxGeometry x="290" y="390" width="230" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;POST /api/analyze&lt;/b&gt;&lt;br&gt;&lt;font style='font-si